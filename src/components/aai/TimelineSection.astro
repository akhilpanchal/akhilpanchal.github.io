---
interface Props {
  date: string;
  isFirst?: boolean;
  isLast?: boolean;
}

const { date, isFirst = false, isLast = false } = Astro.props;
---

<div class="relative pl-8 pb-12 last:pb-0">
  <!-- Timeline spine and dot -->
  <div class="absolute left-0 top-0 bottom-0 w-px bg-border" class:list={{ 'top-4': isFirst, 'bottom-12': isLast }}></div>
  <div class="absolute left-0 top-1 -translate-x-1/2 w-3 h-3 rounded-full bg-primary ring-4 ring-background"></div>
  
  <!-- Date badge -->
  <div class="mb-3">
    <span class="inline-block text-xs font-medium text-muted-foreground bg-muted px-2 py-1 rounded-md">
      {date}
    </span>
  </div>
  
  <!-- Content slot -->
  <div>
    <slot />
  </div>
</div>
