---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Commute Schedule">
  <main class="flex-1 max-w-4xl mx-auto px-4 py-12 w-full">
    <h1 class="text-4xl font-bold mb-4">Commute Schedule</h1>
    <p class="text-sm text-muted-foreground mb-8 italic">
      This schedule was accurate as of the last update. Always verify with the
      <a href="https://www.samtrans.com/schedulesandmaps/timetables/ECR.html"
         target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
        official SamTrans ECR schedule
      </a>.
    </p>
    
    <div class="space-y-12">
      <section>
        <h2 class="text-2xl font-semibold mb-6">To Work</h2>
        <div class="overflow-x-auto border border-border rounded-lg">
          <table class="w-full">
            <thead class="bg-muted">
              <tr>
                <th class="px-4 py-3 text-left text-sm font-semibold">ECR Departs San Carlos</th>
                <th class="px-4 py-3 text-left text-sm font-semibold">ECR Arrives RWC</th>
                <th class="px-4 py-3 text-left text-sm font-semibold">Shuttle Departs RWC</th>
                <th class="px-4 py-3 text-left text-sm font-semibold">Shuttle Arrives 1900/2000</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr class="hover:bg-muted/50">
                <td class="px-4 py-3 text-sm">6:35 AM</td>
                <td class="px-4 py-3 text-sm">6:51 AM</td>
                <td class="px-4 py-3 text-sm">6:52 AM*</td>
                <td class="px-4 py-3 text-sm">7:09 AM</td>
              </tr>
              <tr class="hover:bg-muted/50">
                <td class="px-4 py-3 text-sm">6:50 AM</td>
                <td class="px-4 py-3 text-sm">7:06 AM</td>
                <td class="px-4 py-3 text-sm">7:37 AM</td>
                <td class="px-4 py-3 text-sm">7:54 AM</td>
              </tr>
              <tr class="hover:bg-muted/50">
                <td class="px-4 py-3 text-sm">7:02 AM</td>
                <td class="px-4 py-3 text-sm">7:18 AM</td>
                <td class="px-4 py-3 text-sm">7:37 AM</td>
                <td class="px-4 py-3 text-sm">7:54 AM</td>
              </tr>
              <tr class="hover:bg-muted/50">
                <td class="px-4 py-3 text-sm">7:12 AM</td>
                <td class="px-4 py-3 text-sm">7:28 AM</td>
                <td class="px-4 py-3 text-sm">7:37 AM</td>
                <td class="px-4 py-3 text-sm">7:54 AM</td>
              </tr>
              <tr class="hover:bg-muted/50">
                <td class="px-4 py-3 text-sm">7:25 AM</td>
                <td class="px-4 py-3 text-sm">7:51 AM</td>
                <td class="px-4 py-3 text-sm">8:22 AM</td>
                <td class="px-4 py-3 text-sm">8:39 AM</td>
              </tr>
              <tr class="hover:bg-muted/50">
                <td class="px-4 py-3 text-sm">7:40 AM</td>
                <td class="px-4 py-3 text-sm">8:07 AM</td>
                <td class="px-4 py-3 text-sm">8:22 AM</td>
                <td class="px-4 py-3 text-sm">8:39 AM</td>
              </tr>
              <tr class="hover:bg-muted/50">
                <td class="px-4 py-3 text-sm">7:55 AM</td>
