---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDateShort } from '@/lib/utils';

const allBlogPosts = await getCollection('blog');
const allMusicPosts = await getCollection('music');

// Combine all posts and sort by date descending
const allPosts = [
...allBlogPosts.map(post => ({ ...post, type: 'blog' })),
...allMusicPosts.map(post => ({ ...post, type: 'music' }))
].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout>
  <main class="flex-1 max-w-4xl mx-auto px-4 py-16 w-full">
    <!-- Hero Section -->
    <section class="mb-16 text-center">
      <h1 class="scroll-m-20 text-center text-4xl font-extrabold tracking-tight text-balance">
        Akhil Panchal
      </h1>

      <p class="text-xl text-muted-foreground mb-8">
        Software Engineer | Singer | Outdoor Enthusiast
      </p>
    </section>

    <!-- All Posts -->
    <section>
      <h2 class="text-3xl font-bold mb-6">All Posts</h2>

      <div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-4 items-baseline">
        {allPosts.map((post) => {
        const slug = post.type === 'blog' ? `/posts/${post.slug}` : `/music/${post.slug}`;
        return (
        <>
          <time class="text-sm text-muted-foreground whitespace-nowrap border-b border-border pb-4">
            {formatDateShort(new Date(post.data.date))}
          </time>
          <article>

            <h3 class="text-lg font-medium border-b border-border pb-4">
              <a href={slug} class="hover:text-primary hover:opacity-80 transition-opacity">
                {post.data.title}
              </a>
            </h3>
          </article>
        </>
        );
        })}
      </div>
    </section>
  </main>
</BaseLayout>