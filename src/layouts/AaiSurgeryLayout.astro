---
import BaseLayout from './BaseLayout.astro';
import TimelineSection from '../components/aai/TimelineSection.astro';
import AudioCard from '../components/aai/AudioCard';
import PhotoThumbnail from '../components/aai/PhotoThumbnail';
import VideoEmbed from '../components/aai/VideoEmbed';
import YouTube from '../components/YouTube';
import type { Locale } from '@/data/aai/types';
import type { AaiContent } from '@/data/aai/types';

interface Props {
  locale: Locale;
  content: AaiContent;
}

const { locale, content } = Astro.props;

// Group timeline events by date
const groupedTimeline = content.timeline.reduce((acc, event) => {
  const existingGroup = acc.find(group => group.date === event.date);
  if (existingGroup) {
    existingGroup.events.push(event);
  } else {
    acc.push({ date: event.date, events: [event] });
  }
  return acc;
}, [] as { date: string; events: typeof content.timeline }[]);

const languages: { code: Locale; label: string; url: string }[] = [
  { code: 'en', label: 'English', url: '/aai-surgery' },
  { code: 'hi', label: 'हिन्दी', url: '/aai-surgery/hi' },
  { code: 'mr', label: 'मराठी', url: '/aai-surgery/mr' },
  { code: 'gu', label: 'ગુજરાતી', url: '/aai-surgery/gu' },
];
---

<BaseLayout 
  title={content.meta.title} 
  description={content.meta.description}
  image="/aai/images/mummy-1.jpg"
>
  <main class="flex-1 max-w-4xl mx-auto px-4 py-16 w-full">
    <!-- Header with language switcher -->
    <header class="mb-12 space-y-6">
      <div class="flex justify-center items-center gap-2 text-sm">
        <span class="text-muted-foreground">{content.ui.languageLabel}:</span>
        {languages.map(lang => (
          <a
            href={lang.url}
            class:list={[
              'px-2 py-1 rounded transition-colors',
              locale === lang.code
                ? 'bg-primary text-primary-foreground font-medium'
                : 'text-muted-foreground hover:text-foreground'
            ]}
          >
            {lang.label}
          </a>
        ))}
      </div>

      <div class="text-center space-y-4">
        <h1 class="scroll-m-20 text-4xl font-extrabold tracking-tight text-balance">
          {content.intro.heading}
        </h1>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          {content.intro.subheading}
        </p>
      </div>
    </header>

    <!-- Timeline -->
    <div class="relative">
      {groupedTimeline.map((group, groupIndex) => (
        <TimelineSection
          date={group.date}
          isFirst={groupIndex === 0}
          isLast={groupIndex === groupedTimeline.length - 1}
        >
          {group.events.map((event) => (
            <>
              {event.type === 'milestone' && (
                <div class="space-y-3 mb-8 last:mb-0">
                  <h3 class="text-2xl font-semibold">{event.title}</h3>
                  {event.note && (
                    <p class="text-base text-foreground/80 leading-relaxed text-justify">{event.note}</p>
                  )}
                  {event.photo && (
                    <div class="flex items-center gap-2 flex-wrap">
                      {Array.isArray(event.photo) ? (
                        event.photo.map((photoSrc, idx) => (
                          <PhotoThumbnail
                            src={photoSrc}
                            alt={Array.isArray(event.photoAlt) ? event.photoAlt[idx] : event.photoAlt || event.title}
                            caption={event.note}
                            allPhotos={Array.isArray(event.photo) ? event.photo : undefined}
                            allPhotoAlts={Array.isArray(event.photoAlt) ? event.photoAlt : undefined}
                            initialIndex={idx}
                            client:load
                          />
                        ))
                      ) : (
                        <PhotoThumbnail
                          src={event.photo}
                          alt={Array.isArray(event.photoAlt) ? event.photoAlt[0] : (event.photoAlt || event.title)}
                          caption={event.note}
                          client:load
                        />
                      )}
                      <span class="text-xs text-muted-foreground">{content.ui.clickToExpand}</span>
                    </div>
                  )}
                </div>
              )}

              {event.type === 'song' && event.audio && (
                <div class="mb-8 last:mb-0">
                  <AudioCard
                    src={event.audio}
                    title={event.title}
                    note={event.note || ''}
                    date={event.date}
                    client:load
                  />
                </div>
              )}

              {event.type === 'video' && (event.video || event.youtube) && (
                <div class="space-y-3 mb-8 last:mb-0">
                  <h3 class="text-2xl font-semibold">{event.title}</h3>
                  {event.note && (
                    <p class="text-base text-foreground/80 leading-relaxed text-justify mb-3">{event.note}</p>
                  )}
                  {event.youtube ? (
                    <YouTube id={event.youtube} title={event.title} client:load />
                  ) : event.video && (
                    <VideoEmbed
                      src={event.video}
                      caption=""
                      client:load
                    />
                  )}
                </div>
              )}

              {event.type === 'text' && (
                <div class="space-y-3 mb-8 last:mb-0">
                  <h3 class="text-2xl font-semibold">{event.title}</h3>
                  {event.note && (
                    <p class="text-base text-foreground/80 leading-relaxed text-justify">{event.note}</p>
                  )}
                </div>
              )}
            </>
          ))}
        </TimelineSection>
      ))}
    </div>
  </main>
</BaseLayout>
