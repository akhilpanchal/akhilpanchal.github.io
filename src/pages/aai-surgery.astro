---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineSection from '../components/aai/TimelineSection.astro';
import AudioCard from '../components/aai/AudioCard';
import PhotoThumbnail from '../components/aai/PhotoThumbnail';
import VideoEmbed from '../components/aai/VideoEmbed';
import YouTube from '../components/YouTube';
import { getAaiContent } from '@/lib/i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '@/data/aai/types';

const locale = (Astro.currentLocale || 'en') as Locale;
const content = await getAaiContent(locale);

const languages: { code: Locale; label: string }[] = [
  { code: 'en', label: 'English' },
  { code: 'mr', label: 'मराठी' },
  { code: 'gu', label: 'ગુજરાતી' },
  { code: 'hi', label: 'हिन्दी' }
];
---

<BaseLayout title={content.meta.title} description={content.meta.description}>
  <main class="flex-1 max-w-4xl mx-auto px-4 py-16 w-full">
    <!-- Header with language switcher -->
    <header class="mb-12 space-y-6">
      <div class="flex justify-end items-center gap-2 text-sm">
        <span class="text-muted-foreground">{content.ui.languageLabel}:</span>
        {languages.map(lang => (
          <a
            href={getRelativeLocaleUrl(lang.code, 'aai-surgery')}
            class:list={[
              'px-2 py-1 rounded transition-colors',
              locale === lang.code
                ? 'bg-primary text-primary-foreground font-medium'
                : 'text-muted-foreground hover:text-foreground'
            ]}
          >
            {lang.label}
          </a>
        ))}
      </div>

      <div class="text-center space-y-4">
        <h1 class="scroll-m-20 text-4xl font-extrabold tracking-tight text-balance">
          {content.intro.heading}
        </h1>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          {content.intro.subheading}
        </p>
      </div>
    </header>

    <!-- Timeline -->
    <div class="relative">
      {content.timeline.map((event, index) => (
        <TimelineSection
          date={event.date}
          isFirst={index === 0}
          isLast={index === content.timeline.length - 1}
        >
          {event.type === 'milestone' && (
            <div class="space-y-3">
              <h3 class="text-2xl font-semibold">{event.title}</h3>
              {event.note && (
                <p class="text-base text-foreground/80 leading-relaxed">{event.note}</p>
              )}
              {event.photo && (
                <div class="flex items-center gap-2">
                  <PhotoThumbnail
                    src={event.photo}
                    alt={event.photoAlt || event.title}
                    caption={event.note}
                    client:load
                  />
                  <span class="text-xs text-muted-foreground">{content.ui.clickToExpand}</span>
                </div>
              )}
            </div>
          )}

          {event.type === 'song' && event.audio && (
            <AudioCard
              src={event.audio}
              title={event.title}
              note={event.note || ''}
              date={event.date}
              client:load
            />
          )}

          {event.type === 'video' && (event.video || event.youtube) && (
            <div class="space-y-3">
              <h3 class="text-2xl font-semibold">{event.title}</h3>
              {event.note && (
                <p class="text-base text-foreground/80 leading-relaxed mb-3">{event.note}</p>
              )}
              {event.youtube ? (
                <YouTube id={event.youtube} title={event.title} client:load />
              ) : event.video && (
                <VideoEmbed
                  src={event.video}
                  caption=""
                  client:load
                />
              )}
            </div>
          )}

          {event.type === 'text' && (
            <div class="space-y-3">
              <h3 class="text-2xl font-semibold">{event.title}</h3>
              {event.note && (
                <p class="text-base text-foreground/80 leading-relaxed">{event.note}</p>
              )}
            </div>
          )}
        </TimelineSection>
      ))}
    </div>
  </main>
</BaseLayout>
